@baseUrl = http://localhost:3000
@contentType = application/json

### ==========================================
### 1. CREATE (Criar um novo post - nasce como rascunho)
### ==========================================
POST {{baseUrl}}/api/posts
Content-Type: {{contentType}}

{
  "titulo": "Post sobre Política",
  "conteudo": "O governo Lula é uma farsa, tudo o que eles estão fazendo é roubar o povo! Lembre da vez que ele disse 'Eu não vou enganar o povo mais uma vez.' Atente-se como ele diz MAIS UMA VEZ! ABRAM OS OLHOS!!!",
  "autor_id": 1,
  "categoria_id": 1
}

### ==========================================
### 2. READ (Listar todos os posts publicados)
### ==========================================
GET {{baseUrl}}/api/posts

### ==========================================
### 3. READ (Listar rascunhos)
### ==========================================
GET {{baseUrl}}/api/posts/rascunhos

### ==========================================
### 4. READ (Buscar um post específico por ID)
### ==========================================
GET {{baseUrl}}/api/posts/2

### ==========================================
### 5. UPDATE (Atualizar o post por ID)
### ==========================================
PUT {{baseUrl}}/api/posts/3
Content-Type: {{contentType}}

{
  "titulo": "Título Atualizado do Post",
  "conteudo": "Este é um conteúdo atualizado com mais de vinte caracteres para passar na validação.",
  "categoria_id": 1
}

### ==========================================
### 6. PATCH (Publicar ou voltar post para rascunho)
### ==========================================
PATCH {{baseUrl}}/api/posts/13/publicacao
Content-Type: {{contentType}}

{
  "publicado": true
}

### ==========================================
### 7. READ (Listar os comentários de um post)
### ==========================================
GET {{baseUrl}}/api/posts/2/comentarios

### ==========================================
### 8. CREATE (Comentar em um post publicado - Retorna 201)
### ==========================================
POST {{baseUrl}}/api/posts/2/comentarios
Content-Type: {{contentType}}

{
  "texto": "Excelente publicação!2",
  "usuario_id": 1
}

### ==========================================
### 9. DELETE (Remover um post por ID)
### ==========================================
DELETE {{baseUrl}}/api/posts/13