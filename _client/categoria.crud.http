@baseUrl = http://localhost:3000
@contentType = application/json

### ==========================================
### 1. CREATE (Criar um nova categoria)
### ==========================================
POST {{baseUrl}}/api/categorias
Content-Type: {{contentType}}

{
  "nome": "Nova Categoria"
}

### ==========================================
### 2. READ (Listar todos as categorias)
### ==========================================
GET {{baseUrl}}/api/categorias

### ==========================================
### 3. READ (Buscar uma categoria específica - ID 1)
### ==========================================
GET {{baseUrl}}/api/categorias/2

### ==========================================
### 4. UPDATE (Atualizar completamente a categoria ID 1)
### ==========================================
PUT {{baseUrl}}/api/categorias/2
Content-Type: {{contentType}}

{
  "nome": "Futeballs"
}

### ==========================================
### 5. DELETE (Remover a categoria ID 1)
### ==========================================
DELETE {{baseUrl}}/api/categorias/3