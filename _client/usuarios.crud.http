@baseUrl = http://localhost:3000
@contentType = application/json

### ==========================================
### 1. CREATE (Cria um usuário)
### ==========================================
POST {{baseUrl}}/api/usuarios
Content-Type: {{contentType}}

{
  "nome": "Sonic",
  "email": "OuriçoAzul@Sega.com"
}

### ==========================================
### 2. READ (Lista os usuários)
### ==========================================
GET {{baseUrl}}/api/usuarios

### ==========================================
### 3. READ (Mostra um usuário - ID 1)
### ==========================================
GET {{baseUrl}}/api/usuarios/1

### ==========================================
### 4. READ (Mostra os comentarios de um usuário - ID 1)
### ==========================================
GET {{baseUrl}}/api/usuarios/1/comentarios

### ==========================================
### 5. READ (Mostra os posts de um usuário - ID 1)
### ==========================================
GET {{baseUrl}}/api/usuarios/1/posts

### ==========================================
### 6. UPDATE (Atualiza nome e/ou e-mail - ID 1)
### ==========================================
PUT {{baseUrl}}/api/usuarios/1
Content-Type: {{contentType}}

{
  "nome": "Arnaldo",
  "email": "Arnaldinho67"
}

### ==========================================
### 5. DELETE (Remove um usuário ID 1)
### ==========================================
DELETE {{baseUrl}}/api/usuarios/1